# Postgres connection string (e.g. from Neon, Supabase, or Vercel Postgres).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin login — bcrypt hash of the shared admin password. Generate one with:
#   npx tsx scripts/hash-password.ts "yourpassword"
# IMPORTANT: escape every "$" in the hash as "\$" below — Next.js expands
# unescaped "$word" as an env variable reference and will silently blank
# out the value otherwise. scripts/hash-password.ts prints it pre-escaped.
ADMIN_PASSWORD_HASH=""
# Secret used to sign the admin session cookie. Any long random string.
ADMIN_JWT_SECRET="change-me-in-production"

# IANA timezone used to compute the Wednesday 11:59pm ordering cutoff,
# regardless of the server's own runtime timezone (e.g. UTC on Vercel).
SCHOOL_TIMEZONE="America/New_York"

# Leave the SQUARE_* vars below unset to use the mock payment path: orders
# are recorded as paid without a real charge, clearly labeled
# paymentMode="mock" in the database and admin dashboard. Once a Square
# account exists, set these (sandbox first, then production) and real
# charges will run automatically — no code changes needed.
# SQUARE_ENVIRONMENT="sandbox"
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# NEXT_PUBLIC_SQUARE_ENVIRONMENT="sandbox"
# NEXT_PUBLIC_SQUARE_APPLICATION_ID=
# NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Leave SMTP_HOST unset to use the mock email path: confirmation emails are
# logged and saved to the admin-visible Mock Inbox (/admin/mock-inbox)
# instead of actually sent. Set these once a real mailbox/SMTP provider
# exists.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="NCCS Pizza Fridays <no-reply@example.com>"

PUBLIC_APP_ORIGIN="http://localhost:3000"
